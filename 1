<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Registro Getti Pali</title>
<meta name="theme-color" content="#d4530f">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Getti Pali">
<link rel="apple-touch-icon" href="data:image/png;base64,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
/* Layout: sticky site-log header, scrollable card log of getti, full-screen
   form overlay for entry/edit, tabular mono readout for every numeric/time value */
:root{
  --bg:#eae7df;
  --surface:#ffffff;
  --surface-2:#f3f1ea;
  --fg:#1c1f1a;
  --muted:#6c6f63;
  --border:#d4d0c3;
  --accent:#d4530f;
  --accent-fg:#fff8f3;
  --good:#2f6b3f;
  --danger:#a83232;
  color-scheme:light;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --bg:#15161a;
    --surface:#1e2024;
    --surface-2:#25272c;
    --fg:#eceae4;
    --muted:#9a9d93;
    --border:#33363b;
    --accent:#f0783a;
    --accent-fg:#1c1200;
    --good:#6fbf7f;
    --danger:#e08080;
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#15161a;
  --surface:#1e2024;
  --surface-2:#25272c;
  --fg:#eceae4;
  --muted:#9a9d93;
  --border:#33363b;
  --accent:#f0783a;
  --accent-fg:#1c1200;
  --good:#6fbf7f;
  --danger:#e08080;
  color-scheme:dark;
}
*{box-sizing:border-box}
html,body{height:100%}
body{
  margin:0;
  background:var(--bg);
  color:var(--fg);
  font-family:'Archivo',system-ui,-apple-system,"Segoe UI",sans-serif;
  -webkit-text-size-adjust:100%;
}
body::before{
  content:"";
  position:fixed;
  inset:0 0 auto;
  height:env(safe-area-inset-top,0px);
  z-index:20;
  background:var(--surface-2);
}
.gutter{
  padding-left:max(16px, env(safe-area-inset-left,0px));
  padding-right:max(16px, env(safe-area-inset-right,0px));
}
h1,h2,h3{font-family:'Archivo',system-ui,sans-serif;margin:0;text-wrap:balance}
.mono{font-family:'IBM Plex Mono',ui-monospace,monospace;font-variant-numeric:tabular-nums}
button{font-family:inherit}

/* ---- top bar ---- */
header.topbar{
  position:sticky;
  top:env(safe-area-inset-top,0px);
  z-index:15;
  background:var(--surface-2);
  border-bottom:1px solid var(--border);
}
header.topbar .inner{
  padding-block:14px;
  display:flex;
  align-items:baseline;
  justify-content:space-between;
  gap:12px;
}
header.topbar h1{font-size:19px;font-weight:800;letter-spacing:-0.01em}
header.topbar .count{font-size:12px;color:var(--muted)}

main{padding-block:16px 100px;min-height:100%}

/* ---- empty state ---- */
.empty{
  margin-top:14vh;
  text-align:center;
  color:var(--muted);
}
.empty .mark{
  width:52px;height:52px;margin:0 auto 14px;
  border:2px solid var(--border);border-radius:12px;
  display:flex;align-items:center;justify-content:center;
}
.empty h2{font-size:16px;color:var(--fg);margin-bottom:6px}
.empty p{font-size:13.5px;max-width:260px;margin:0 auto;line-height:1.5}

/* ---- record cards ---- */
.card-list{display:flex;flex-direction:column;gap:10px}
.card{
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:14px;
  padding:14px;
  display:flex;
  flex-direction:column;
  gap:10px;
}
.card .row1{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}
.card .ddt{font-size:11px;letter-spacing:.04em;color:var(--muted);text-transform:uppercase}
.card .ddt b{color:var(--fg);font-size:13px;letter-spacing:0;text-transform:none}
.card .date{font-size:13px;font-weight:600}
.card .stats{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:8px;
  padding-top:8px;
  border-top:1px dashed var(--border);
}
.stat{min-width:0}
.stat .k{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.04em}
.stat .v{font-size:14px;font-weight:600}
.pali-chip{
  display:inline-flex;align-items:center;gap:5px;
  background:var(--surface-2);border:1px solid var(--border);
  border-radius:999px;padding:3px 10px 3px 8px;font-size:12px;
  color:var(--fg);
}
.pali-chip .n{
  background:var(--accent);color:var(--accent-fg);
  border-radius:999px;width:17px;height:17px;font-size:10px;font-weight:700;
  display:flex;align-items:center;justify-content:center;
}
.card .actions{display:flex;gap:8px;flex-wrap:wrap}
.btn{
  border:1px solid var(--border);
  background:var(--surface-2);
  color:var(--fg);
  border-radius:9px;
  padding:9px 13px;
  font-size:13px;
  font-weight:600;
  cursor:pointer;
  display:inline-flex;align-items:center;gap:6px;
  min-width:0;
}
.btn:active{opacity:.75}
.btn.primary{background:var(--accent);color:var(--accent-fg);border-color:var(--accent)}
.btn.ghost{background:transparent}
.btn.sm{padding:7px 10px;font-size:12px}
.btn.danger{color:var(--danger);border-color:var(--danger)}
.btn:focus-visible{outline:2px solid var(--accent);outline-offset:2px}

/* ---- fab ---- */
.fab{
  position:fixed;
  right:max(18px, calc(env(safe-area-inset-right,0px) + 14px));
  bottom:max(18px, calc(env(safe-area-inset-bottom,0px) + 14px));
  z-index:18;
  background:var(--accent);
  color:var(--accent-fg);
  border:none;
  border-radius:999px;
  width:58px;height:58px;
  font-size:28px;
  font-weight:600;
  box-shadow:0 6px 16px -4px rgba(0,0,0,.35);
  cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  line-height:1;
}
.fab:active{transform:scale(.95)}

/* ---- form overlay ---- */
.overlay{
  position:fixed;inset:0;
  background:var(--bg);
  z-index:30;
  display:flex;
  flex-direction:column;
  overflow:hidden;
}
.overlay .formhead{
  position:sticky;top:env(safe-area-inset-top,0px);
  background:var(--surface-2);
  border-bottom:1px solid var(--border);
  padding-block:14px;
  display:flex;align-items:center;justify-content:space-between;gap:10px;
  z-index:2;
}
.overlay .formhead h2{font-size:17px}
.overlay .formbody{overflow-y:auto;padding-block:16px 120px;flex:1}
.section{margin-bottom:22px}
.section-title{
  font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;
  color:var(--muted);margin-bottom:10px;
}
.field-grid{
  display:grid;grid-template-columns:1fr 1fr;gap:10px;
}
.field{display:flex;flex-direction:column;gap:5px;min-width:0}
.field.full{grid-column:1 / -1}
.field label{font-size:11.5px;color:var(--muted);font-weight:600}
.field input{
  font-family:'IBM Plex Mono',ui-monospace,monospace;
  font-size:15px;
  padding:10px 11px;
  border-radius:9px;
  border:1px solid var(--border);
  background:var(--surface);
  color:var(--fg);
  width:100%;
  min-width:0;
}
.field input:focus{outline:2px solid var(--accent);outline-offset:1px;border-color:var(--accent)}
.field .unit{font-size:11px;color:var(--muted);margin-top:1px}

.palo-row{
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:12px;
  padding:12px;
  margin-bottom:10px;
  position:relative;
}
.palo-row .palo-head{
  display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;
}
.palo-row .palo-head .tag{
  font-size:11px;font-weight:700;color:var(--muted);letter-spacing:.04em;text-transform:uppercase;
}
.palo-row .remove{
  border:none;background:transparent;color:var(--danger);
  font-size:13px;font-weight:600;cursor:pointer;padding:4px 6px;
}
.add-palo{
  width:100%;border:1.5px dashed var(--border);background:transparent;
  color:var(--accent);border-radius:12px;padding:12px;font-weight:700;
  font-size:13.5px;cursor:pointer;
}
.summary-bar{
  display:flex;justify-content:space-between;align-items:center;
  background:var(--surface-2);border:1px solid var(--border);border-radius:10px;
  padding:10px 12px;margin-top:4px;font-size:12.5px;color:var(--muted);
}
.summary-bar b{color:var(--fg)}
.diff-warn{color:var(--danger)}
.diff-ok{color:var(--good)}

.overlay .formfoot{
  position:fixed;left:0;right:0;bottom:0;
  padding-bottom:max(14px, env(safe-area-inset-bottom,0px));
  padding-top:12px;
  background:var(--surface-2);
  border-top:1px solid var(--border);
  display:flex;gap:10px;
  z-index:3;
}
.overlay .formfoot .btn{flex:1;justify-content:center;padding-block:12px;font-size:14px}

.toast{
  position:fixed;left:50%;bottom:max(90px, calc(env(safe-area-inset-bottom,0px) + 80px));
  transform:translateX(-50%);
  background:var(--fg);color:var(--bg);
  padding:10px 16px;border-radius:999px;font-size:13px;font-weight:600;
  z-index:50;opacity:0;pointer-events:none;transition:opacity .2s ease;
}
.toast.show{opacity:1}

@media (min-width:640px){
  .gutter{max-width:640px;margin-inline:auto;padding-left:16px;padding-right:16px}
  header.topbar .inner, .overlay .formhead, .overlay .formbody, .overlay .formfoot{max-width:640px;margin-inline:auto}
}
</style>
</head>
<body>

<header class="topbar">
  <div class="inner gutter">
    <h1>Registro Getti — Pali</h1>
    <span class="count mono" id="countLabel">0 getti</span>
  </div>
</header>

<main class="gutter">
  <div id="app"></div>
</main>

<button class="fab" id="fabNew" aria-label="Nuovo getto">+</button>

<div id="overlayRoot"></div>
<div class="toast" id="toast"></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>

<script>
(function(){
  "use strict";

  var STORAGE_KEY = "cantiere_getti_pali_v1";

  function uid(){ return Date.now().toString(36) + Math.random().toString(36).slice(2,8); }

  function loadRecords(){
    try{
      var raw = localStorage.getItem(STORAGE_KEY);
      return raw ? JSON.parse(raw) : [];
    }catch(e){ return []; }
  }
  function saveRecords(list){
    try{ localStorage.setItem(STORAGE_KEY, JSON.stringify(list)); }catch(e){ /* storage unavailable */ }
  }

  var records = loadRecords();

  function todayISO(){
    var d = new Date();
    var m = String(d.getMonth()+1).padStart(2,"0");
    var day = String(d.getDate()).padStart(2,"0");
    return d.getFullYear()+"-"+m+"-"+day;
  }
  function fmtDateIt(iso){
    if(!iso) return "—";
    var p = iso.split("-");
    return p.length===3 ? (p[2]+"/"+p[1]+"/"+p[0]) : iso;
  }
  function n(v, dec){
    if(v===""||v===null||v===undefined||isNaN(v)) return "—";
    return Number(v).toFixed(dec===undefined?1:dec).replace(/\.0+$/,"").replace(/(\.\d*[1-9])0+$/,"$1");
  }
  function esc(s){
    return String(s===undefined||s===null?"":s).replace(/[&<>"]/g, function(c){
      return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c];
    });
  }

  function newPalo(){ return { key: uid(), idPalo:"", diametro:"", volumeTeorico:"" }; }
  function newRecord(){
    return {
      id: uid(),
      data: todayISO(),
      ddt: "",
      volumeAutobetoniera: "",
      slump: "",
      temperatura: "",
      oraInizio: "",
      oraFine: "",
      pali: [ newPalo() ],
      createdAt: Date.now()
    };
  }

  var appEl = document.getElementById("app");
  var overlayRoot = document.getElementById("overlayRoot");
  var countLabel = document.getElementById("countLabel");
  var toastEl = document.getElementById("toast");
  var toastTimer = null;

  function showToast(msg){
    toastEl.textContent = msg;
    toastEl.classList.add("show");
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function(){ toastEl.classList.remove("show"); }, 2200);
  }

  function renderList(){
    countLabel.textContent = records.length + (records.length===1 ? " getto" : " getti");

    if(records.length===0){
      appEl.innerHTML =
        '<div class="empty">'+
          '<div class="mark">📋</div>'+
          '<h2>Nessun getto registrato</h2>'+
          '<p>Tocca il pulsante + per registrare il primo getto: dati del DDT e i pali interessati.</p>'+
        '</div>';
      return;
    }

    var sorted = records.slice().sort(function(a,b){ return b.createdAt - a.createdAt; });
    var html = '<div class="card-list">';
    sorted.forEach(function(r){
      var totVol = r.pali.reduce(function(s,p){ return s + (parseFloat(p.volumeTeorico)||0); }, 0);
      html +=
        '<div class="card">'+
          '<div class="row1">'+
            '<div>'+
              '<div class="date mono">'+fmtDateIt(r.data)+'</div>'+
              '<div class="ddt">DDT <b>'+esc(r.ddt||"—")+'</b></div>'+
            '</div>'+
            '<span class="pali-chip"><span class="n">'+r.pali.length+'</span>pali</span>'+
          '</div>'+
          '<div class="stats">'+
            '<div class="stat"><div class="k">Volume autob.</div><div class="v mono">'+n(r.volumeAutobetoniera,1)+' m³</div></div>'+
            '<div class="stat"><div class="k">Slump</div><div class="v mono">'+n(r.slump,1)+' cm</div></div>'+
            '<div class="stat"><div class="k">Getto</div><div class="v mono">'+(r.oraInizio||"—")+'–'+(r.oraFine||"—")+'</div></div>'+
          '</div>'+
          '<div class="actions">'+
            '<button class="btn sm" data-act="edit" data-id="'+r.id+'">Apri / Modifica</button>'+
            '<button class="btn sm ghost" data-act="pdf" data-id="'+r.id+'">Esporta PDF</button>'+
          '</div>'+
        '</div>';
    });
    html += '</div>';
    appEl.innerHTML = html;
  }

  function closeOverlay(){
    overlayRoot.innerHTML = "";
  }

  function renderForm(recordId){
    var isNew = !recordId;
    var rec = isNew ? newRecord() : JSON.parse(JSON.stringify(records.find(function(r){ return r.id===recordId; })));
    if(!rec){ closeOverlay(); renderList(); return; }
    if(!rec.pali || rec.pali.length===0) rec.pali = [newPalo()];

    function paliRowHtml(p, idx){
      return (
        '<div class="palo-row" data-key="'+p.key+'">'+
          '<div class="palo-head">'+
            '<span class="tag">Palo '+(idx+1)+'</span>'+
            (rec.pali.length>1 ? '<button type="button" class="remove" data-removepalo="'+p.key+'">Rimuovi</button>' : '')+
          '</div>'+
          '<div class="field-grid">'+
            '<div class="field full">'+
              '<label for="idpalo-'+p.key+'">ID Palo</label>'+
              '<input id="idpalo-'+p.key+'" data-field="idPalo" data-key="'+p.key+'" type="text" inputmode="text" placeholder="es. P12" value="'+esc(p.idPalo)+'">'+
            '</div>'+
            '<div class="field">'+
              '<label for="diam-'+p.key+'">Diametro</label>'+
              '<input id="diam-'+p.key+'" data-field="diametro" data-key="'+p.key+'" type="number" inputmode="decimal" step="1" placeholder="cm" value="'+esc(p.diametro)+'">'+
              '<span class="unit">cm</span>'+
            '</div>'+
            '<div class="field">'+
              '<label for="voltheo-'+p.key+'">Volume teorico</label>'+
              '<input id="voltheo-'+p.key+'" data-field="volumeTeorico" data-key="'+p.key+'" type="number" inputmode="decimal" step="0.01" placeholder="m³" value="'+esc(p.volumeTeorico)+'">'+
              '<span class="unit">m³</span>'+
            '</div>'+
          '</div>'+
        '</div>'
      );
    }

    function totalsHtml(){
      var totTeorico = rec.pali.reduce(function(s,p){ return s + (parseFloat(p.volumeTeorico)||0); }, 0);
      var autob = parseFloat(rec.volumeAutobetoniera)||0;
      var diffCls = "";
      var diffTxt = "";
      if(autob>0 && totTeorico>0){
        var diff = autob - totTeorico;
        diffCls = Math.abs(diff) < 0.001 ? "diff-ok" : "diff-warn";
        diffTxt = (diff>=0?"+":"")+n(diff,2)+" m³ vs. autobetoniera";
      }
      return (
        '<div class="summary-bar">'+
          '<span>Volume teorico totale</span>'+
          '<b class="mono">'+n(totTeorico,2)+' m³'+(diffTxt?'  <span class="'+diffCls+'">('+diffTxt+')</span>':'')+'</b>'+
        '</div>'
      );
    }

    function fullHtml(){
      return (
        '<div class="overlay">'+
          '<div class="formhead gutter">'+
            '<button class="btn ghost sm" id="btnCancel">Annulla</button>'+
            '<h2>'+(isNew?"Nuovo getto":"Modifica getto")+'</h2>'+
            '<span style="width:64px"></span>'+
          '</div>'+
          '<div class="formbody gutter">'+

            '<div class="section">'+
              '<div class="section-title">Dati getto / DDT</div>'+
              '<div class="field-grid">'+
                '<div class="field"><label for="f-data">Data</label><input id="f-data" data-field="data" type="date" value="'+esc(rec.data)+'"></div>'+
                '<div class="field"><label for="f-ddt">N. DDT</label><input id="f-ddt" data-field="ddt" type="text" placeholder="es. 00123" value="'+esc(rec.ddt)+'"></div>'+
                '<div class="field"><label for="f-vol">Volume autobetoniera</label><input id="f-vol" data-field="volumeAutobetoniera" type="number" inputmode="decimal" step="0.1" placeholder="m³" value="'+esc(rec.volumeAutobetoniera)+'"><span class="unit">m³</span></div>'+
                '<div class="field"><label for="f-slump">Slump</label><input id="f-slump" data-field="slump" type="number" inputmode="decimal" step="0.5" placeholder="cm" value="'+esc(rec.slump)+'"><span class="unit">cm</span></div>'+
                '<div class="field"><label for="f-temp">Temperatura cls</label><input id="f-temp" data-field="temperatura" type="number" inputmode="decimal" step="0.5" placeholder="°C" value="'+esc(rec.temperatura)+'"><span class="unit">°C</span></div>'+
                '<div class="field"></div>'+
                '<div class="field"><label for="f-oi">Ora inizio getto</label><input id="f-oi" data-field="oraInizio" type="time" value="'+esc(rec.oraInizio)+'"></div>'+
                '<div class="field"><label for="f-of">Ora fine getto</label><input id="f-of" data-field="oraFine" type="time" value="'+esc(rec.oraFine)+'"></div>'+
              '</div>'+
            '</div>'+

            '<div class="section">'+
              '<div class="section-title">Pali</div>'+
              '<div id="paliList">'+
                rec.pali.map(paliRowHtml).join("")+
              '</div>'+
              '<button type="button" class="add-palo" id="btnAddPalo">+ Aggiungi palo</button>'+
              '<div id="totalsBox">'+totalsHtml()+'</div>'+
            '</div>'+

          '</div>'+
          '<div class="formfoot gutter">'+
            (!isNew ? '<button class="btn danger" id="btnDelete">Elimina</button>' : '')+
            '<button class="btn primary" id="btnSave">Salva getto</button>'+
          '</div>'+
        '</div>'
      );
    }

    overlayRoot.innerHTML = fullHtml();

    function bind(){
      document.getElementById("btnCancel").onclick = function(){ closeOverlay(); };

      overlayRoot.querySelectorAll('[data-field]').forEach(function(inp){
        inp.addEventListener("input", function(){
          var field = inp.getAttribute("data-field");
          var key = inp.getAttribute("data-key");
          if(key){
            var p = rec.pali.find(function(x){ return x.key===key; });
            if(p) p[field] = inp.value;
            if(field==="volumeTeorico"){
              document.getElementById("totalsBox").innerHTML = totalsHtml();
            }
          } else {
            rec[field] = inp.value;
            if(field==="volumeAutobetoniera"){
              document.getElementById("totalsBox").innerHTML = totalsHtml();
            }
          }
        });
      });

      overlayRoot.querySelectorAll('[data-removepalo]').forEach(function(btn){
        btn.onclick = function(){
          var key = btn.getAttribute("data-removepalo");
          rec.pali = rec.pali.filter(function(p){ return p.key!==key; });
          overlayRoot.innerHTML = fullHtml();
          bind();
        };
      });

      document.getElementById("btnAddPalo").onclick = function(){
        rec.pali.push(newPalo());
        overlayRoot.innerHTML = fullHtml();
        bind();
        var rows = overlayRoot.querySelectorAll(".palo-row");
        var last = rows[rows.length-1];
        if(last){
          var firstInput = last.querySelector("input");
          if(firstInput) firstInput.focus();
          last.scrollIntoView({block:"center", behavior:"smooth"});
        }
      };

      var delBtn = document.getElementById("btnDelete");
      if(delBtn){
        delBtn.onclick = function(){
          records = records.filter(function(r){ return r.id!==rec.id; });
          saveRecords(records);
          closeOverlay();
          renderList();
          showToast("Getto eliminato");
        };
      }

      document.getElementById("btnSave").onclick = function(){
        if(!rec.ddt || !rec.ddt.trim()){
          showToast("Inserisci il numero del DDT");
          document.getElementById("f-ddt").focus();
          return;
        }
        var validPali = rec.pali.filter(function(p){ return p.idPalo && p.idPalo.trim(); });
        if(validPali.length===0){
          showToast("Inserisci almeno un ID Palo");
          return;
        }
        rec.pali = validPali;

        var idx = records.findIndex(function(r){ return r.id===rec.id; });
        if(idx>=0){ records[idx] = rec; } else { records.push(rec); }
        saveRecords(records);
        closeOverlay();
        renderList();
        showToast("Getto salvato");
      };
    }
    bind();
  }

  // ---- PDF export (temporary layout — da sostituire con il modello fornito) ----
  function exportPdf(recordId){
    var rec = records.find(function(r){ return r.id===recordId; });
    if(!rec){ return; }
    if(!window.jspdf || !window.jspdf.jsPDF){
      showToast("Libreria PDF non disponibile");
      return;
    }
    var doc = new window.jspdf.jsPDF({ unit:"mm", format:"a4" });
    var pageW = doc.internal.pageSize.getWidth();
    var marginX = 16;

    doc.setFont("helvetica","bold");
    doc.setFontSize(14);
    doc.text("REGISTRO GETTO — PALI DI FONDAZIONE", marginX, 20);
    doc.setDrawColor(210,80,20);
    doc.setLineWidth(0.8);
    doc.line(marginX, 23, pageW-marginX, 23);

    var infoRows = [
      ["Data", fmtDateIt(rec.data)],
      ["N. DDT", rec.ddt || "—"],
      ["Volume autobetoniera", n(rec.volumeAutobetoniera,2)+" m³"],
      ["Slump", n(rec.slump,1)+" cm"],
      ["Temperatura cls", n(rec.temperatura,1)+" °C"],
      ["Ora inizio getto", rec.oraInizio || "—"],
      ["Ora fine getto", rec.oraFine || "—"]
    ];

    doc.autoTable({
      startY: 29,
      theme: "plain",
      margin: { left: marginX, right: marginX },
      styles: { font:"helvetica", fontSize:10, cellPadding:1.3 },
      columnStyles: { 0:{ fontStyle:"bold", cellWidth:48 } },
      body: infoRows
    });

    var afterInfoY = doc.lastAutoTable.finalY + 8;
    doc.setFontSize(11);
    doc.setFont("helvetica","bold");
    doc.text("Pali interessati dal getto", marginX, afterInfoY);

    var totTeorico = rec.pali.reduce(function(s,p){ return s + (parseFloat(p.volumeTeorico)||0); }, 0);

    doc.autoTable({
      startY: afterInfoY + 4,
      margin: { left: marginX, right: marginX },
      head: [["ID Palo","Diametro (cm)","Volume teorico (m³)"]],
      body: rec.pali.map(function(p){
        return [p.idPalo || "—", n(p.diametro,1), n(p.volumeTeorico,2)];
      }),
      foot: [["Totale", "", n(totTeorico,2)]],
      headStyles: { fillColor:[28,31,26], textColor:255, fontStyle:"bold" },
      footStyles: { fillColor:[243,241,234], textColor:[28,31,26], fontStyle:"bold" },
      styles: { font:"helvetica", fontSize:10, cellPadding:2.2 }
    });

    var pageH = doc.internal.pageSize.getHeight();
    doc.setFontSize(8);
    doc.setFont("helvetica","normal");
    doc.setTextColor(120);
    doc.text("Documento generato il "+new Date().toLocaleString("it-IT")+" — layout provvisorio.", marginX, pageH-10);

    var filename = "getto_"+(rec.ddt||rec.id)+"_"+rec.data+".pdf";
    try{
      doc.save(filename);
    }catch(e){
      showToast("Esportazione non riuscita");
    }
  }

  appEl.addEventListener("click", function(e){
    var btn = e.target.closest("[data-act]");
    if(!btn) return;
    var act = btn.getAttribute("data-act");
    var id = btn.getAttribute("data-id");
    if(act==="edit") renderForm(id);
    if(act==="pdf") exportPdf(id);
  });

  document.getElementById("fabNew").onclick = function(){ renderForm(null); };

  renderList();
})();
</script>
</body>
